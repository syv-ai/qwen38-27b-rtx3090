# Copy this file to .env before starting Docker Compose.
# .env is ignored by git so local keys and tuning changes stay out of commits.
#
# Every knob the stack reads, with its default. The enabled lines are the
# recommended speed-first single-user config for a local RTX 3090; everything
# else is commented -- uncomment to override. Vars marked [managed] are computed
# per CTX/SPEC by the launchers: leave them commented unless overriding.

# Speed-first single-user config for a local RTX 3090.
# This is the repo's recommended default for best speed when the card is yours alone.
SPEC=dflash2
PREFIX_CACHE=1

# VLLM_API_KEY=
# REQUIRED before the port is reachable by anything but this machine -- the
# server has no authentication at all without it. Generate one rather than
# inventing one:
#   Linux/WSL:  echo "VLLM_API_KEY=$(openssl rand -hex 24)" >> .env

# GPU_UUID=
# Pin the serving card by UUID (nvidia-smi -L). Required on multi-GPU boxes
# where Docker's `count: 1` is ignored (Docker Desktop/WSL2): without it CUDA
# device 0 may be the wrong card.
#   e.g. GPU_UUID=GPU-2e8e4d29-ecb0-5fbf-7a84-d2370311be84

# Optional toggles kept commented out for easy activation later.
# Uncomment ONLY when you need the behaviour below.

# PORT=18020
# Change only if you need to avoid a local port conflict.
#HOST=0.0.0.0
#MODEL=models/Qwen3.8-27B-W4A16-AutoRound (default; -fast variant picked when prepared)
#MODELS_DIR=./models (bind mount; a venv install and the container can share one dir)

# CTX=fast
# Launcher default: bf16 KV via FlashAttention, ~64k context. The speed winner.
# CTX=long
# About 150k context, at ~95-100 tok/s instead of 127. Set SPEC=mtp with it: DFlash2
# past 64k is worth it only for context reproduction and loses to SPEC=mtp CTX=long
# roughly 2:1 on everything else.

# CTX=huge
# The KVarN 4/2-bit KV cache: 240k context (268k tokens of pool), and it combines with
# the SPEC=dflash2 above -- keep PREFIX_CACHE=1, since the first turn over a long document
# is the expensive one. Slower than the default profile: 67 tok/s across mixed tasks,
# 164 while reproducing. The container already has KVarN built in; a venv install needs
# bash kvarn/install.sh first.

# The launcher's own default is SPEC=mtp; this template sets dflash2 above because it is the
# faster single-user profile. The line below is enabled for Docker Desktop/WSL2, which needs
# it or the V2 runner aborts with UVA errors. On native Linux it is a no-op -- platforms/
# cuda.py reads it only inside the WSL-detected branch -- so leaving it on costs nothing.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# DFLASH_TOKENS=15
# Use when the model is reproducing or quoting a long prompt/document/code block.
# This is the "copy/edit/quote" mode: much faster when the answer is reusing context,
# but it reduces request slots and context headroom compared with the default 7-token verify block.
# Typical use: long docs, code edits, RAG with quoting, prompt-copy workloads.
# DRAFT=/path/to/drafter (default: auto-find Qwen3.8-27B-DFlash2-W4A16 in models/)
#DRAFT_METHOD=dflash (dspark runs the RadixArk DSpark drafter; slower, see README)
#DRAFT_SAMPLE=probabilistic (the only measured setting; unset costs ~16% acceptance, #73)
# LOOKUP=1
# DFlash2 lookup-augmented drafting.
# Leave enabled unless you are debugging DFlash2 drafting behavior.
#LOOKUP_ADAPTIVE= (default: adaptive block; set 0 to pin with DFLASH_TOKENS>7 on CTX=huge)
# DFLASH_MAX_LEN= (default: per-profile ceiling; beats MAX_LEN. Precedence: DFLASH_MAX_LEN > MAX_LEN > profile default)
# SPEC_ATTN=1
# Split-KV attention for the MTP verify step on CTX=fast.
# Leave default unless you specifically want to tune the MTP attention path.
# API_SERVERS=1 (default; vLLM API server count)
# ASYNC_SCHED=1 (default; 0 for long DFlash2 verify blocks, sync scheduling path)
# CG= (default: MAX_SEQS*(DRAFT_TOKENS+1) capped at 64; cudagraph capture budget)
#CUDAGRAPH_MODE= (default: vLLM default; PIECEWISE required on CTX=huge+SPEC!=dflash2, gotcha 37)

# GPU_UTIL=0.93
# WSL2 fallback for startup memory headroom; default for this repo's single-user path is 0.93.
# Uncomment only if WSL/Docker is tight and the server refuses to boot on Windows/WSL2.
# [managed] memory -- sized per profile; uncomment to override:
#MAX_SEQS= (default: 8 fast/mtp, 4 long/dflash2, 2 huge/dflash2, 64 batch; seats, not residency)
# MAX_LEN=65536
# Override only if you intentionally want a different context ceiling for the active profile.
# The defaults are chosen for the profile in [single-user/start_qwen.sh](single-user/start_qwen.sh).
#KV_MEM= (default: pinned bytes per profile, e.g. 5583457484; empty falls back to GPU_UTIL)
#VLLM_V2_CUDAGRAPH_MEM_MIB= (default 1400, 1900 for wide verify blocks; V2 graph reservation)

# INT8_ACT=int8
# Only for extra prefill speed in some workloads; not the main speed knob for single-user decode.
# Best used if you care about prompt-side throughput and are okay with the tradeoff.
#INT8_LAYERS=mlp|linear_attn|self_attn (default; which linears go int8)

# PREFILL_ATTN=int8
# Companion to INT8_ACT for prefill optimization on a few long prompts.
# Useful for heavy prompt workloads; not generally needed for normal chat/coding sessions.

# Batch profile (only for --profile batch):
#KV=fp8 (default; kvarn needs install, int4pth needs nothing. 262k context both)
#KVARN_POOL_MEM_FRAC=0.25 (batch; single-user huge uses 0.15)

#EXTRA_ARGS= (last on the vLLM command line, wins over everything; e.g. --tensor-parallel-size 2)
#TOOLS=1 (default; 0 disables tool calling)
#TOOL_PARSER=qwen3_coder (default; must match the chat template, NOT hermes)
#REQ_METRICS=1 (per-request timing + usage in responses; not with --disable-log-stats)
#VISION=1 (keep the 0.85 GiB vision tower for image inputs; default off = --language-model-only)
#VISION_OFFLOAD=1 (default; tower weights in host RAM, required for VISION=1 on 24 GB)
#VLLM_VISION_CPU_OFFLOAD_GB=1 (default; GiB reserved for the offloaded tower)

# Runtime / allocator:
#PYTORCH_CUDA_ALLOC_CONF= (default: expandable_segments:False on WSL2, :True native)
#VLLM_OFFLOAD_KEEP_SHM=1 (skip stale /dev/shm/offload cleanup; multi-engine sharing)
#VLLM_SPEC_DECODE_ATTN= (default per profile; split-KV verify attention switch)
#VLLM_SPEC_DECODE_ATTN_QMAX= (default DRAFT_TOKENS+1; verify buffer sizing)

# Entrypoint (docker/entrypoint.sh):
#PREPARE=0 (skip idempotent model prepare before serve — also skips the chat-template effort translation, gotcha 58)
#VERIFY=0 (skip verify.sh --no-server gate before serve)

# FAST_VARIANT=0
# Uncomment only if you want to skip the extra fast-variant download during the first boot.
# This is a lighter first-time setup and can help on constrained hosts, but it gives up the faster variant.
#DFLASH2=0 (skip ~1 GB DFlash2 drafter fetch; SPEC=dflash2 unavailable then)
#BASE_MODEL_DIR=/app/models/Qwen3.8-27B-W4A16-AutoRound (default; prepare target dir)
#HF_REPO=dbirks/Qwen3.8-27B-W4A16-AutoRound (default; download source)

# HEADROOM_PORT=8787
# Headroom compression proxy in front of the server (docker-compose `headroom`
# service, OpenAI-compatible on this port, same API key). HEADROOM_MODE=cache
# keeps vLLM prefix-cache hits stable; `token` compresses harder.
